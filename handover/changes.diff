+                stage="resampling",
+                elapsed_ms=elapsed(),
+                detail=f"Aligned to standardized 4.00s window ({TARGET_SAMPLES} samples)",
+            )
+            await asyncio.sleep(0.01)
+
+            # -------------------------------------------------------------
+            # Stage 3: Feature Extraction (LFCC + Log-Mel)
+            # -------------------------------------------------------------
+            raw_lfcc = self.predictor.lfcc_ext(aligned_wave)  # (F=60, T)
