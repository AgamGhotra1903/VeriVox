+
+            explanation = (
+                f"Stacked meta-learner fused 6 base models with decision threshold {threshold:.4f}. "
+                f"{confidence_note} Key contributors: CRNN-LFCC ({scores_by_name['CRNN-LFCC']:+.2f}) and GMM ({scores_by_name['GMM']:+.2f})."
