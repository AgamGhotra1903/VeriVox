+    win_length: 400
+    hop_length: 160
+    n_mels: 80
+    f_min: 0.0
+    f_max: 8000.0
+    power: 2.0
+    top_db: 80.0
+
+model:
+  name: "crnn_forensics"
+  in_channels: 1
+  in_freq_dim: 80
+  features: "logmel"
+  use_gru: true
+  use_attention: true
+  pooling: "attention"  # 'attention' or 'mean'
+  proj_dim: 128
+  gru_hidden: 128
+  num_gru_layers: 2
+  gru_dropout: 0.3
+  conv_dropout: 0.1
+  classifier_dropout: 0.3
+  num_attn_heads: 4
+  num_classes: 2
+  init_weights: true
+
+training:
+  batch_size: 32
+  num_workers: 0
+  epochs: 40
+  learning_rate: 0.001
+  weight_decay: 0.0001
+  optimizer: "adamw"  # 'adamw' or 'adam'
+  lr_scheduler: "plateau"  # 'plateau' (ReduceLROnPlateau) or 'cosine'
+  min_lr: 0.000001
+  amp: true
+  grad_clip_norm: 5.0
+
+  early_stopping:
+    enabled: true
+    patience: 5
+    monitor: "dev_eer"
+    mode: "min"
+
+  loss:
+    type: "weighted_cross_entropy"
