+                        eval_min_tdcf=float(r["Eval min-tDCF"]) if pd.notna(r.get("Eval min-tDCF")) else None,
+                    )
+                )
+
+        # 4. Architecture Ablations
+        arch_rows = []
+        p_arch = tables_dir / "architecture_ablation.csv"
+        if p_arch.exists():
+            df_a = pd.read_csv(p_arch)
+            for _, r in df_a.iterrows():
+                arch_rows.append(
