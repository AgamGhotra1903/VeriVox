+import React from 'react';
+import { motion } from 'framer-motion';
+import { Check, Loader2, AlertCircle } from 'lucide-react';
+import { clsx } from 'clsx';
+import { PipelineEvent } from '../../types/api';
+
+export interface PipelineTrackerProps {
+  events: PipelineEvent[];
+  isComplete: boolean;
+  error?: string | null;
+  className?: string;
+}
+
+export const PipelineTracker: React.FC<PipelineTrackerProps> = ({
+  events,
+  isComplete,
+  error,
+  className,
+}) => {
+  const stageDefs = [
+    { key: 'validating', label: 'Audio Validation', desc: '16 kHz mono check, SNR, and clipping estimation' },
+    { key: 'resampling', label: 'Window Alignment', desc: '4.0s (64,000 samples) center crop / padding' },
+    { key: 'feature_extraction', label: 'Feature Extraction', desc: 'LFCC (60-dim) and Log-Mel (80-dim) filterbanks' },
+    { key: 'model_scores', label: 'Ensemble Evaluation', desc: 'CRNNs, GMM, SVM, Random Forest, Logistic Reg' },
+    { key: 'ensemble', label: 'Meta-Learner Stacking', desc: 'L2 logistic regression fusion & calibration' },
+  ];
+
+  const latestEvent = events.length > 0 ? events[events.length - 1] : null;
+  const currentStageKey = latestEvent ? latestEvent.stage : null;
+
+  const stageTimings: Record<string, number> = {};
+  events.forEach((ev) => {
+    stageTimings[ev.stage] = ev.elapsed_ms;
+  });
+
+  return (
+    <div
+      className={clsx(
+        'border border-borderSubtle bg-surface rounded-[12px] p-4 sm:p-5 flex flex-col gap-3 shadow-card select-none animate-card-mount',
+        className
+      )}
+    >
+      <div className="flex items-center justify-between border-b border-borderSubtle pb-3">
+        <div className="flex items-center gap-2">
+          <span
+            className={clsx(
+              'w-2 h-2 rounded-full inline-block',
+              error
+                ? 'bg-spoof'
+                : isComplete
+                ? 'bg-genuine'
+                : 'bg-primary animate-pulse'
+            )}
+          />
+          <span className="text-xs font-semibold text-txt-primary">
+            Analysis Pipeline
+          </span>
+        </div>
+        {latestEvent && (
+          <span className="text-xs font-mono text-txt-secondary tabular-nums">
+            {latestEvent.elapsed_ms.toFixed(0)} ms
+          </span>
+        )}
+      </div>
+
+      <div className="space-y-2">
+        {stageDefs.map((stage) => {
+          const isDone = isComplete || (events.some((e) => e.stage === stage.key) && currentStageKey !== stage.key);
+          const isCurrent = currentStageKey === stage.key && !isComplete;
+          const timing = stageTimings[stage.key];
+
+          return (
+            <div
+              key={stage.key}
+              className={clsx(
+                'flex items-center justify-between p-2.5 rounded-[8px] border text-xs transition-colors duration-150',
+                isDone
+                  ? 'bg-surface border-borderSubtle text-txt-primary'
+                  : isCurrent
+                  ? 'bg-primary/5 border-primary/20 text-txt-primary'
+                  : 'bg-elevated/40 border-transparent text-txt-muted'
+              )}
+            >
+              <div className="flex items-center gap-2.5">
+                <div
+                  className={clsx(
+                    'w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 text-[10px]',
+                    isDone
+                      ? 'bg-genuine/10 text-genuine'
+                      : isCurrent
+                      ? 'bg-primary/10 text-primary'
+                      : 'bg-elevated text-txt-muted'
+                  )}
+                >
+                  {isDone ? (
+                    <Check className="w-3 h-3 stroke-[2.5]" />
+                  ) : isCurrent ? (
+                    <Loader2 className="w-3 h-3 animate-spin text-primary" />
+                  ) : (
+                    '·'
+                  )}
+                </div>
+
+                <div>
+                  <p className="font-medium text-txt-primary">
+                    {stage.label}
+                  </p>
+                  <p className="text-[11px] text-txt-secondary">
+                    {stage.desc}
+                  </p>
+                </div>
+              </div>
+
+              {timing !== undefined && (
+                <span className="text-[11px] font-mono text-txt-secondary tabular-nums ml-2">
+                  {timing.toFixed(0)} ms
+                </span>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {error && (
+        <div className="p-3 bg-rose-50 border border-rose-200 text-rose-700 dark:bg-rose-950/20 dark:border-rose-900/40 dark:text-rose-300 rounded-[8px] text-xs flex items-center gap-2">
+          <AlertCircle className="w-4 h-4 text-spoof flex-shrink-0" />
+          <span>{error}</span>
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/frontend/src/components/visualizations/SpectrogramCanvas.tsx b/frontend/src/components/visualizations/SpectrogramCanvas.tsx
new file mode 100644
index 0000000..cf74bdc
--- /dev/null
+++ b/frontend/src/components/visualizations/SpectrogramCanvas.tsx
@@ -0,0 +1,157 @@
+import React, { useRef, useEffect, useState } from 'react';
+import { clsx } from 'clsx';
+
+export interface SpectrogramCanvasProps {
+  lfccData: number[][]; // (60, T)
+  logmelData: number[][]; // (80, T)
+  durationSec: number;
+  currentTime?: number;
+  height?: number;
+  className?: string;
+}
+
+export const SpectrogramCanvas: React.FC<SpectrogramCanvasProps> = ({
+  lfccData,
+  logmelData,
+  durationSec,
+  currentTime = 0,
+  height = 120,
+  className,
+}) => {
+  const [activeMode, setActiveMode] = useState<'lfcc' | 'logmel'>('lfcc');
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+
+  const activeMatrix = activeMode === 'lfcc' ? lfccData : logmelData;
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas || !activeMatrix || activeMatrix.length === 0) return;
+
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+
+    const isDark =
+      typeof window !== 'undefined' &&
+      (document.documentElement.classList.contains('dark') ||
+        window.matchMedia('(prefers-color-scheme: dark)').matches);
+
+    const numFreqBins = activeMatrix.length;
+    const numTimeBins = activeMatrix[0].length;
+    if (numTimeBins === 0) return;
+
+    const dpr = window.devicePixelRatio || 1;
+    const rect = canvas.getBoundingClientRect();
+    canvas.width = rect.width * dpr;
+    canvas.height = height * dpr;
+    ctx.scale(dpr, dpr);
+
+    const w = rect.width;
+    const h = height;
+
+    // Find min and max for normalization
+    let minVal = Infinity;
+    let maxVal = -Infinity;
+    for (let f = 0; f < numFreqBins; f++) {
+      for (let t = 0; t < numTimeBins; t++) {
+        const v = activeMatrix[f][t];
+        if (v < minVal) minVal = v;
+        if (v > maxVal) maxVal = v;
+      }
+    }
+    const valRange = maxVal - minVal || 1e-6;
+
+    const binW = w / numTimeBins;
+    const binH = h / numFreqBins;
+
+    // Restrained, calm sequential colormap (Deep Slate -> Muted Indigo -> Soft Teal -> Pale Gold)
+    for (let f = 0; f < numFreqBins; f++) {
+      const y = h - (f + 1) * binH;
+      for (let t = 0; t < numTimeBins; t++) {
+        const norm = (activeMatrix[f][t] - minVal) / valRange;
+        const x = t * binW;
+
+        let r = 0, g = 0, b = 0;
+        if (norm < 0.35) {
+          const factor = norm / 0.35;
+          r = Math.round(15 + 45 * factor);
+          g = Math.round(23 + 40 * factor);
+          b = Math.round(42 + 90 * factor);
+        } else if (norm < 0.75) {
+          const factor = (norm - 0.35) / 0.4;
+          r = Math.round(60 + 50 * factor);
+          g = Math.round(63 + 90 * factor);
+          b = Math.round(132 + 30 * factor);
+        } else {
+          const factor = (norm - 0.75) / 0.25;
+          r = Math.round(110 + 110 * factor);
+          g = Math.round(153 + 70 * factor);
+          b = Math.round(162 - 40 * factor);
+        }
+
+        ctx.fillStyle = `rgb(${r},${g},${b})`;
+        ctx.fillRect(x, y, Math.ceil(binW), Math.ceil(binH));
+      }
+    }
+
+    // Playhead line
+    if (durationSec > 0) {
+      const progressFrac = currentTime / durationSec;
+      const playheadX = progressFrac * w;
+      ctx.strokeStyle = isDark ? '#ffffff' : '#0f172a';
+      ctx.lineWidth = 1.5;
+      ctx.beginPath();
+      ctx.moveTo(playheadX, 0);
+      ctx.lineTo(playheadX, h);
+      ctx.stroke();
+    }
+  }, [activeMatrix, durationSec, currentTime, height]);
+
+  return (
+    <div className={clsx('flex flex-col gap-2', className)}>
+      {/* Mode Switcher Bar */}
+      <div className="flex items-center justify-between">
+        <span className="text-xs font-medium text-txt-secondary uppercase tracking-wide">
+          Spectrogram Representation
+        </span>
+
+        <div className="flex items-center gap-1 p-0.5 bg-elevated border border-borderSubtle rounded-[8px]">
+          <button
+            onClick={() => setActiveMode('lfcc')}
+            className={clsx(
+              'px-2.5 py-1 rounded-[6px] text-xs transition-colors duration-150',
+              activeMode === 'lfcc'
+                ? 'bg-surface text-txt-primary font-medium shadow-card'
+                : 'text-txt-secondary hover:text-txt-primary'
+            )}
+          >
+            LFCC (60-dim)
+          </button>
+          <button
+            onClick={() => setActiveMode('logmel')}
+            className={clsx(
+              'px-2.5 py-1 rounded-[6px] text-xs transition-colors duration-150',
+              activeMode === 'logmel'
+                ? 'bg-surface text-txt-primary font-medium shadow-card'
+                : 'text-txt-secondary hover:text-txt-primary'
+            )}
+          >
+            Log-Mel (80-dim)
+          </button>
+        </div>
+      </div>
+
+      {/* Canvas Well with Frequency Axis Ticks */}
+      <div className="relative rounded-[8px] overflow-hidden border border-borderSubtle bg-chassis">
+        <canvas ref={canvasRef} height={height} className="w-full block select-none" />
+
+        {/* Y-Axis Frequency Indicators */}
+        <div className="absolute top-1.5 left-2 pointer-events-none text-[10px] font-mono text-txt-secondary bg-surface/90 px-1.5 py-0.5 rounded border border-borderSubtle">
+          {activeMode === 'lfcc' ? 'Coeff 60 (HF)' : '8 kHz'}
+        </div>
+        <div className="absolute bottom-1.5 left-2 pointer-events-none text-[10px] font-mono text-txt-secondary bg-surface/90 px-1.5 py-0.5 rounded border border-borderSubtle">
+          {activeMode === 'lfcc' ? 'Coeff 1 (LF)' : '0 Hz'}
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/frontend/src/components/visualizations/WaveformCanvas.tsx b/frontend/src/components/visualizations/WaveformCanvas.tsx
new file mode 100644
index 0000000..c625a7c
--- /dev/null
+++ b/frontend/src/components/visualizations/WaveformCanvas.tsx
@@ -0,0 +1,153 @@
+import React, { useRef, useEffect } from 'react';
+
+export interface WaveformCanvasProps {
+  peaks: number[]; // Min/Max downsampled peak pairs
+  durationSec: number;
+  currentTime: number;
+  onSeek?: (time: number) => void;
+  height?: number;
+  className?: string;
+}
+
+export const WaveformCanvas: React.FC<WaveformCanvasProps> = ({
+  peaks,
+  durationSec,
+  currentTime,
+  onSeek,
+  height = 96,
+  className,
+}) => {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const isDraggingRef = useRef(false);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas || peaks.length === 0) return;
+
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+
+    const isDark =
+      typeof window !== 'undefined' &&
+      (document.documentElement.classList.contains('dark') ||
+        window.matchMedia('(prefers-color-scheme: dark)').matches);
+
+    const dpr = window.devicePixelRatio || 1;
+    const rect = canvas.getBoundingClientRect();
+    canvas.width = rect.width * dpr;
+    canvas.height = height * dpr;
+    ctx.scale(dpr, dpr);
+
+    const w = rect.width;
+    const h = height;
+    const midY = h / 2;
+
+    // Neutral background fill
+    ctx.fillStyle = isDark ? '#0f172a' : '#f8fafc';
+    ctx.fillRect(0, 0, w, h);
+
+    // Light center baseline
+    ctx.strokeStyle = isDark ? 'rgba(148, 163, 184, 0.15)' : 'rgba(148, 163, 184, 0.25)';
+    ctx.lineWidth = 1;
+    ctx.beginPath();
+    ctx.moveTo(0, midY);
+    ctx.lineTo(w, midY);
+    ctx.stroke();
+
+    // Light time gridlines
+    const numMarkers = 6;
+    ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
+    ctx.font = '10px Inter, sans-serif';
+    for (let i = 1; i < numMarkers; i++) {
+      const x = (w / numMarkers) * i;
+      ctx.beginPath();
+      ctx.moveTo(x, 0);
+      ctx.lineTo(x, h);
+      ctx.strokeStyle = isDark ? 'rgba(148, 163, 184, 0.1)' : 'rgba(148, 163, 184, 0.15)';
+      ctx.stroke();
+
+      const sec = ((durationSec / numMarkers) * i).toFixed(1);
+      ctx.fillText(`${sec}s`, x + 4, h - 6);
+    }
+
+    // Draw waveform bars with restrained palette
+    const numPairs = peaks.length / 2;
+    const barWidth = Math.max(1.5, w / numPairs);
+    const progressFrac = durationSec > 0 ? currentTime / durationSec : 0;
+    const playheadX = progressFrac * w;
+
+    const playedColor = isDark ? '#6366f1' : '#4f46e5'; // Muted indigo
+    const unplayedColor = isDark ? '#334155' : '#cbd5e1'; // Neutral slate
+
+    for (let i = 0; i < numPairs; i++) {
+      const minVal = peaks[i * 2];
+      const maxVal = peaks[i * 2 + 1];
+      const x = i * barWidth;
+
+      const yMin = midY - maxVal * (midY * 0.88);
+      const yMax = midY - minVal * (midY * 0.88);
+      const barHeight = Math.max(2, yMax - yMin);
+
+      ctx.fillStyle = x <= playheadX ? playedColor : unplayedColor;
+      ctx.beginPath();
+      ctx.roundRect
+        ? ctx.roundRect(x, yMin, Math.max(1, barWidth - 1), barHeight, 2)
+        : ctx.rect(x, yMin, Math.max(1, barWidth - 1), barHeight);
+      ctx.fill();
+    }
+
+    // Minimal playhead line
+    if (durationSec > 0) {
+      ctx.strokeStyle = isDark ? '#f8fafc' : '#0f172a';
+      ctx.lineWidth = 1.5;
+      ctx.beginPath();
+      ctx.moveTo(playheadX, 0);
+      ctx.lineTo(playheadX, h);
+      ctx.stroke();
+
+      ctx.fillStyle = playedColor;
+      ctx.beginPath();
+      ctx.arc(playheadX, 4, 3, 0, Math.PI * 2);
+      ctx.fill();
+    }
+  }, [peaks, durationSec, currentTime, height]);
+
+  // Click & drag scrub handling
+  const handleSeekEvent = (e: React.MouseEvent<HTMLCanvasElement>) => {
+    if (!onSeek || !canvasRef.current || durationSec <= 0) return;
+    const rect = canvasRef.current.getBoundingClientRect();
+    const clickX = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
+    const targetTime = (clickX / rect.width) * durationSec;
+    onSeek(targetTime);
+  };
+
+  const handleMouseDown = (e: React.MouseEvent<HTMLCanvasElement>) => {
+    isDraggingRef.current = true;
+    handleSeekEvent(e);
+  };
+
+  const handleMouseMove = (e: React.MouseEvent<HTMLCanvasElement>) => {
+    if (isDraggingRef.current) {
+      handleSeekEvent(e);
+    }
+  };
+
+  const handleMouseUp = () => {
+    isDraggingRef.current = false;
+  };
+
+  return (
+    <div className="relative rounded-[8px] overflow-hidden border border-borderSubtle bg-chassis group">
+      <canvas
+        ref={canvasRef}
+        height={height}
+        onMouseDown={handleMouseDown}
+        onMouseMove={handleMouseMove}
+        onMouseUp={handleMouseUp}
+        onMouseLeave={handleMouseUp}
+        className="w-full cursor-pointer block select-none"
+        title="Click or drag to scrub playback"
+      />
+    </div>
+  );
+};
diff --git a/frontend/src/index.css b/frontend/src/index.css
new file mode 100644
