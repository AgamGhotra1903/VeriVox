+    )
+    d = pred.to_dict()
+    assert d["verdict"] == "genuine"
+    assert d["prob_genuine"] == 0.88
+    assert d["prob_synthetic"] == 0.12
+    assert "explanation" in d
+    assert len(d["window_analysis"]) == 2
