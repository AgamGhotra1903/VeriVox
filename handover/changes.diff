+                  <span className="text-[11px] px-2 py-0.5 bg-elevated border border-borderSubtle text-txt-secondary rounded-full font-medium">
+                    {step.tag}
+                  </span>
+                </div>
+                <p className="text-xs text-txt-secondary leading-relaxed">
+                  {step.desc}
+                </p>
+              </div>
+            </div>
