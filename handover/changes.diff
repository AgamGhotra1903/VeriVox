+def evaluate_split(
+    model: nn.Module,
+    loader: DataLoader,
+    device: torch.device,
+    criterion: nn.Module,
+) -> tuple[float, np.ndarray, np.ndarray]:
+    model.eval()
+    tot_loss = 0.0
+    tot_cnt = 0
+    all_scores = []
+    all_labels = []
+    with torch.no_grad():
+        for b_x, b_y in loader:
+            b_x = per_utterance_cmvn(b_x.to(device=device, dtype=torch.float32)).unsqueeze(1)
+            b_y = b_y.to(device)
+            logits, _ = model(b_x)
+            loss = criterion(logits, b_y)
+            tot_loss += loss.item() * len(b_y)
+            tot_cnt += len(b_y)
+            scores = (logits[:, BONAFIDE] - logits[:, SPOOF]).cpu().numpy()
+            all_scores.append(scores)
+            all_labels.append(b_y.cpu().numpy())
+    avg_loss = tot_loss / max(1, tot_cnt)
+    scores_arr = np.concatenate(all_scores, axis=0)
+    labels_arr = np.concatenate(all_labels, axis=0)
+    return avg_loss, scores_arr, labels_arr
